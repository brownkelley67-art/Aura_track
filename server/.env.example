# Server
PORT=5000

# JWT — use a random secret of at least 32 characters; SUPABASE_JWT_SECRET is also accepted
JWT_SECRET=CHANGE_ME_generate_a_random_64_char_hex_string

# Legacy SQLite path (only needed for data migration)
DB_PATH=./database.sqlite

# Supabase PostgreSQL — DATABASE_URL is preferred; Vercel POSTGRES_URL is also accepted
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# Supabase project credentials — SUPABASE_URL or NEXT_PUBLIC_SUPABASE_URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── Email / SMTP ────────────────────────────────────────────────────
# For Gmail: use smtp.gmail.com / 587, and generate a Google App Password
# For other providers: use their SMTP host and port
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password_here
COMPANY_EMAIL=your_email@gmail.com

# Frontend URL for CORS and email links
FRONTEND_URL=https://auratrack-psi.vercel.app
